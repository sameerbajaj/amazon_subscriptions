{
  "manifest_version": 3,
  "name": "Unsub — Amazon Subscribe & Save Canceler",
  "version": "1.1.0",
  "description": "Easily view and bulk-cancel Amazon Subscribe & Save subscriptions in one click.",
  "author": "Luminos Labs",
  "homepage_url": "https://sameerbajaj.com/tools/amazon-subscriptions/",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.amazon.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}